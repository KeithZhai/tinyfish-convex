{
  "name": "tinyfish-convex",
  "version": "0.1.0",
  "description": "Typed TinyFish Search and Fetch actions for Convex.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "PUBLISHING.md",
    "example/README.md",
    "docs/DECISIONS.md",
    "docs/VALIDATION.md",
    "CHANGELOG.md",
    "docs/EVALUATION.md"
  ],
  "sideEffects": false,
  "keywords": [
    "convex",
    "component",
    "tinyfish",
    "search",
    "fetch",
    "convex-component"
  ],
  "exports": {
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./test": "./src/test.ts",
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component": {
      "types": "./dist/component/_generated/component.d.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "codegen": "convex codegen --component-dir src/component",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p example/tsconfig.json --noEmit",
    "test": "vitest run",
    "check": "npm run generate:contract && npm run build && npm run typecheck && npm test && npm run example:build",
    "example:dev": "vite --config example/vite.config.ts",
    "example:build": "vite build --config example/vite.config.ts",
    "example:backend": "convex dev",
    "prepack": "npm run build",
    "smoke:live": "node scripts/smoke-live.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "generate:contract": "node scripts/generate-contract.mjs",
    "demo": "node scripts/demo-local.mjs",
    "test:live": "node scripts/acceptance-live.mjs",
    "prepublishOnly": "npm run check"
  },
  "peerDependencies": {
    "convex": "^1.42.0"
  },
  "devDependencies": {
    "convex": "^1.46.0",
    "convex-test": "0.0.61",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0",
    "@types/node": "^24.0.0",
    "vite": "^8.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0"
  },
  "author": "Keith Zhai",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KeithZhai/tinyfish-convex.git"
  },
  "homepage": "https://github.com/KeithZhai/tinyfish-convex#readme",
  "bugs": {
    "url": "https://github.com/KeithZhai/tinyfish-convex/issues"
  }
}
